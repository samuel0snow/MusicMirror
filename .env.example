# Run locally without external accounts or infrastructure.
HOST=127.0.0.1
PORT=3000
DATA_DIR=.data
PROVIDER_MODE=mock
ALLOW_DEMO_AUTH=true
ENABLE_TEST_PAGE=false
# Real mode: self-host the Enhanced API and set PROVIDER_MODE=netease.
NETEASE_BASE_URL=http://127.0.0.1:3001
UPSTREAM_TIMEOUT_MS=10000
UPSTREAM_MIN_INTERVAL_MS=250
REFRESH_COOLDOWN_MS=60000
# Optional: 64 hexadecimal characters (32-byte AES key).
# Without this, local development creates .data/encryption.key.
# ENCRYPTION_KEY=
