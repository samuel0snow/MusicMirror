page{background:#f9fafe;color:#202438;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:30rpx;line-height:1.6}view,text,button,input,textarea{box-sizing:border-box}button{font-size:30rpx;line-height:1.5;border-radius:28rpx;margin:0;padding:22rpx 30rpx;min-height:88rpx}button::after{border:0}button[disabled]{opacity:.55}button.primary{background:var(--ink);color:var(--surface);font-weight:600}button.secondary{background:var(--wash);color:var(--accent)}button.danger{background:#ae354b;color:#fff}button.link{background:transparent;color:var(--accent);padding:14rpx 0;text-align:left}input,textarea{border:1rpx solid var(--stroke);background:var(--surface);color:var(--ink);border-radius:20rpx;padding:20rpx;min-height:88rpx;width:100%}textarea{height:190rpx}
.screen{--bg:#f9fafe;--surface:#fff;--ink:#202438;--muted:#626980;--stroke:#dfe3ef;--accent:#6550b9;--cyan:#087d91;--wash:#eeebf8;min-height:100vh;background:linear-gradient(145deg,var(--bg),var(--wash));color:var(--ink);padding-bottom:calc(40rpx + env(safe-area-inset-bottom))}.screen.dark{--bg:#111629;--surface:#20263d;--ink:#f5f3ff;--muted:#b9bed3;--stroke:#39405b;--accent:#c4b1ff;--cyan:#70d9e9;--wash:#27263f}.content{padding:24rpx 46rpx 40rpx}.eyebrow{font-size:22rpx;letter-spacing:3rpx;color:var(--accent);margin:16rpx 0}.title{font-size:48rpx;font-weight:650;line-height:1.3;margin:18rpx 0 24rpx}.subtitle,.muted{color:var(--muted)}.subtitle{font-size:28rpx;margin-bottom:28rpx}.card{background:var(--surface);border:1rpx solid var(--stroke);border-radius:40rpx;padding:32rpx;margin:24rpx 0}.card.accent{border-left:7rpx solid var(--accent)}.card.cyan{border-left:7rpx solid var(--cyan)}.heading{font-size:34rpx;font-weight:600;margin-bottom:16rpx}.big{font-size:62rpx;font-weight:650;line-height:1.2}.small{font-size:25rpx}.caption{font-size:23rpx;color:var(--muted);margin-top:16rpx;word-break:break-word}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;padding:20rpx 0;border-bottom:1rpx solid var(--stroke)}.row:last-child{border-bottom:0}.row>view{min-width:0;flex:1}.stack>view{margin-bottom:18rpx}.actions{margin-top:30rpx}.actions button{margin:16rpx 0}.badge{display:inline-block;border-radius:14rpx;background:var(--wash);color:var(--accent);font-size:23rpx;padding:6rpx 16rpx;margin:6rpx 10rpx 6rpx 0}.badge.cyan{color:var(--cyan)}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.tabs{display:flex;gap:8rpx;background:var(--wash);padding:7rpx;border-radius:24rpx;margin:24rpx 0;flex-wrap:wrap}.tabs button{flex:1;background:transparent;color:var(--muted);font-size:25rpx;padding:17rpx 12rpx;min-height:76rpx}.tabs button.selected{background:var(--surface);color:var(--accent);font-weight:600}.empty{padding:46rpx 20rpx;text-align:center}.rule{padding:14rpx 0;border-bottom:1rpx solid var(--stroke)}.list-button{text-align:left;background:var(--surface);color:var(--ink);width:100%;padding:26rpx 0;border-bottom:1rpx solid var(--stroke);border-radius:0}.field{margin:22rpx 0}.field text{display:block;margin-bottom:10rpx}.error{border-left:6rpx solid #ae354b}.pill{font-size:25rpx;display:block;color:var(--accent)}.selected-card{border-color:var(--accent);box-shadow:0 0 0 2rpx var(--accent)}.qr{width:420rpx;height:420rpx;background:white;display:block;margin:24rpx auto;border-radius:24rpx}.facts{word-break:break-word}.fact-label{font-size:23rpx;color:var(--muted)}.fact-value{font-size:28rpx}.date{font-variant-numeric:tabular-nums}.poster{width:100%;border-radius:32rpx}.poster-canvas{width:600px;height:900px;position:fixed;left:-2000px;top:0}.prism-wrap{height:360rpx;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}.prism{height:190rpx;width:190rpx;background:linear-gradient(135deg,#ab95e9aa,#77d8e588);transform:rotate(35deg) skew(-9deg,-9deg);border:2rpx solid #c5b3f1;box-shadow:0 20rpx 70rpx #a795d94d}.prism::before{content:"";position:absolute;left:50%;height:100%;border-left:2rpx solid #fff9;transform:rotate(20deg)}.orbit{position:absolute;width:350rpx;height:95rpx;border:2rpx solid var(--cyan);border-radius:50%;transform:rotate(-22deg);opacity:.5}.note{padding:22rpx;border-radius:20rpx;background:var(--wash);margin:18rpx 0}.checkline{display:flex;gap:14rpx;align-items:center;padding:18rpx 0}.spacer{height:20rpx}
