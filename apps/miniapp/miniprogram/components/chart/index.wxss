.bar-row{margin:24rpx 0}.bar-label{display:flex;justify-content:space-between;gap:20rpx;font-size:25rpx;margin-bottom:10rpx}.bar-label text:first-child{flex:1;word-break:break-word}.track{height:14rpx;background:var(--wash);border-radius:10rpx;overflow:hidden}.fill{height:14rpx;border-radius:10rpx;background:var(--accent)}.stat{height:300rpx;display:flex;align-items:center;justify-content:center;position:relative}.halo{position:absolute;width:235rpx;height:235rpx;border:18rpx solid var(--wash);border-top-color:var(--accent);border-right-color:var(--cyan);border-radius:50%;transform:rotate(-30deg)}.stat-value{font-size:52rpx;font-weight:650;z-index:1}
