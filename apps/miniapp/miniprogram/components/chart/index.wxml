<view wx:if="{{kind==='bars'}}"><view wx:for="{{rows}}" wx:key="id" class="bar-row"><view class="bar-label"><text>{{item.name}}</text><text>{{item.display}}</text></view><view class="track"><view class="fill" style="width:{{item.width}}%"></view></view></view><view wx:if="{{!rows.length}}" class="empty muted">暂无可用分布</view></view><view wx:elif="{{kind==='stat'}}" class="stat"><view class="halo"></view><text class="stat-value">{{value}}</text></view><view wx:elif="{{kind==='empty'}}" class="empty"><view class="big muted">—</view><view class="muted">资料不足，暂不下结论</view></view><view wx:else class="prism-wrap"><view class="prism"></view><view class="orbit"></view></view><view wx:if="{{caption}}" class="caption">{{caption}}</view>
