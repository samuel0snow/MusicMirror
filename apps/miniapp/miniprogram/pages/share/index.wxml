<view class="screen {{theme}}"><mm-header back="{{true}}" bindback="back"/><view class="content"><mm-state busy="{{busy}}" error="{{error}}" bindretry="retry"/><view class="eyebrow">SHARE / 只分享你愿意的部分</view><view class="title">一张属于你的镜像</view><view class="card"><picker range="{{choices}}" range-key="title" value="{{selected}}" bindchange="choice"><button class="secondary">{{choices[selected].title || '暂无可分享的卡片'}}　⌄</button></picker><view class="row"><view>显示昵称（默认关闭）</view><switch checked="{{nickname}}" data-key="nickname" bindchange="toggle" color="#6550b9"/></view><view class="row"><view>显示两首代表作品（默认关闭）</view><switch checked="{{songs}}" data-key="songs" bindchange="toggle" color="#6550b9"/></view><view class="caption">始终保留采集日期、样本范围、覆盖与解释边界。</view></view><canvas wx:if="{{generating}}" class="poster-canvas" canvas-id="poster" style="width:600px;height:900px"/><image wx:if="{{poster}}" src="{{poster}}" mode="widthFix" class="poster"/><view class="actions"><button class="primary" bindtap="generate" disabled="{{busy || !choices.length}}">生成预览图片</button><button wx:if="{{poster}}" class="secondary" bindtap="save">保存到相册</button></view></view></view>
