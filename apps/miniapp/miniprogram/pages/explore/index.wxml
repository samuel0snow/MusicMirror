<view class="screen {{theme}}"><mm-header back="{{false}}" bindback="back"/><view class="content"><mm-state busy="{{busy}}" error="{{error}}" bindretry="retry"/><view class="eyebrow">EXPLORE / 线索与共性</view><view class="title">看看偏好如何相遇</view><view class="tabs"><button class="{{mode==='cards'?'selected':''}}" bindtap="mode" data-mode="cards">12张卡片</button><button class="{{mode==='long'?'selected':''}}" bindtap="mode" data-mode="long">长期结构</button><button class="{{mode==='heart'?'selected':''}}" bindtap="mode" data-mode="heart">主动偏好</button></view><block wx:if="{{report}}"><block wx:if="{{mode==='cards'}}"><view wx:for="{{report.cards}}" wx:key="id" class="card" bindtap="open" data-id="{{item.id}}" role="button"><view class="badge">{{item.statusText}} · 覆盖 {{item.coverageText}}</view><view class="heading">{{item.title}}　›</view><view class="muted">{{item.summaries[0] || item.purpose}}</view></view><view wx:if="{{report.legacy}}" class="note">历史报告不含新卡片，请从历史打开原始结果或刷新分析。</view></block><block wx:else><view class="note">{{mode==='long'?'长期Top100 · 播放次数加权':'选定红心 · 每首歌曲等权'}}<view></view>{{mode==='heart'?report.heartWindow:'未进入Top100不等于从未听过'}}</view><view class="tabs"><button wx:if="{{mode==='long'}}" bindtap="dimension" data-id="songs">歌曲</button><button bindtap="dimension" data-id="artists">歌手</button><button bindtap="dimension" data-id="albums">专辑</button><button bindtap="dimension" data-id="styles">曲风</button><button bindtap="dimension" data-id="languages">语种</button><button bindtap="dimension" data-id="decades">年代</button></view><view class="card"><mm-chart kind="bars" rows="{{chartRows}}" caption="当前维度的已知权重份额"/><view wx:for="{{distribution}}" wx:key="id" class="row"><view>{{item.name}}</view><text>{{item.display}}</text></view><view wx:if="{{!distribution.length}}" class="muted">此维度暂无可靠数据。</view></view><block wx:if="{{mode==='heart'}}"><view wx:for="{{heartSongs}}" wx:key="songId" class="card"><view>{{item.name}}</view><view class="caption">{{item.state}} · 红心时间 {{item.dateLabel}}</view></view><button class="secondary" bindtap="go" data-url="/pages/inputs/index">编辑选定红心</button></block><button wx:if="{{mode==='long'}}" class="secondary" bindtap="go" data-url="/pages/structure/index">打开完整长期结构 →</button><button wx:if="{{mode==='heart'}}" class="secondary" bindtap="go" data-url="/pages/preferences/index">打开完整主动偏好 →</button></block></block></view></view>
