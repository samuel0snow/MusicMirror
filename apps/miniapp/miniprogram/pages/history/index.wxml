<view class="screen {{theme}}"><mm-header back="{{false}}" bindback="back"/><view class="content"><mm-state busy="{{busy}}" error="{{error}}" bindretry="retry"/><view class="eyebrow">HISTORY / 留住每一次镜像</view><view class="title">你的审美，有了时间轴</view><button class="secondary" bindtap="go" data-url="/pages/trends/index">查看持续变化 →</button><checkbox-group bindchange="select"><view wx:for="{{items}}" wx:key="snapshotId" class="card"><label class="checkline"><checkbox value="{{item.snapshotId}}" color="#6550b9"/><text>{{item.date}}</text></label><view class="caption">{{item.algorithmVersion}}<view></view>{{item.modules.longTermListening.sampleSize}} 首长期 / {{item.modules.recentFavorites.sampleSize}} 首红心</view><button class="link" bindtap="open" data-id="{{item.snapshotId}}">查看当时的报告 →</button></view></checkbox-group><view wx:if="{{!busy && !items.length}}" class="card empty">还没有保存的镜像。先完成一次分析。<button class="link" bindtap="go" data-url="/pages/inputs/index">开始配置输入</button></view><button wx:if="{{hasMore}}" class="secondary" bindtap="more" disabled="{{busy}}">加载更多历史</button><button wx:if="{{items.length}}" class="primary" bindtap="compare">比较选中的 {{selected.length}} 份报告</button></view></view>
