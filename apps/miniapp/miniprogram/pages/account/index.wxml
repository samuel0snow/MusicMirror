<view class="screen {{theme}}"><mm-header back="{{false}}" bindback="back"/><view class="content"><mm-state busy="{{busy}}" error="{{error}}" bindretry="retry"/><view class="eyebrow">YOUR MUSIC / YOUR DATA</view><view class="title">音乐由你，资料也由你</view><view class="card"><view class="heading">{{account.nickname}}</view><view class="badge">{{bound?'已连接':'已解绑，历史报告保留'}}</view><view wx:if="{{account.mode==='mock'}}" class="badge">演示账号</view><button wx:if="{{!bound}}" class="link" bindtap="go" data-url="/pages/login/index">重新连接网易云</button></view><view class="card"><view class="heading">外观</view><view class="tabs"><button bindtap="themeChange" data-id="system" class="{{themeChoice==='system'?'selected':''}}">跟随系统</button><button bindtap="themeChange" data-id="light" class="{{themeChoice==='light'?'selected':''}}">浅色</button><button bindtap="themeChange" data-id="dark" class="{{themeChoice==='dark'?'selected':''}}">深色</button></view></view><view class="card"><button class="list-button" bindtap="go" data-url="/pages/inputs/index">管理两类输入　›</button><button class="list-button" bindtap="go" data-url="/pages/privacy/index">隐私与数据生命周期　›</button><button class="list-button" bindtap="go" data-url="/pages/export/index">导出报告与输入　›</button><button class="list-button" bindtap="go" data-url="/pages/share/index">生成分享图片　›</button></view><view class="actions"><button wx:if="{{bound}}" class="secondary" bindtap="unbind" disabled="{{busy}}">解除连接</button><button class="secondary" bindtap="logout" disabled="{{busy}}">退出登录</button><button class="danger" bindtap="remove" disabled="{{busy}}">删除全部项目数据</button></view></view></view>
