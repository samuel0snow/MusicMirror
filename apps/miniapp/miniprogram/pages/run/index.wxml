<view class="screen {{theme}}"><mm-header back="{{true}}" bindback="back"/><view class="content"><mm-state busy="{{busy}}" error="{{error}}" bindretry="retry"/><view class="eyebrow">ANALYSIS / 可稍后继续</view><view class="title">{{statusText}}</view><view class="card"><mm-chart kind="prism"/><view class="heading">{{status==='completed'?(unchanged?'资料没有变化，沿用已有报告':'新的镜像已准备好'):'让线索慢慢浮现'}}</view><view class="muted">{{status==='completed'?'报告保留对应的采集时间与输入。':'可离开页面，稍后恢复同一个任务。不需要重复提交。'}}</view></view><view class="actions"><button wx:if="{{snapshotId}}" class="primary" bindtap="open">查看本次报告</button><button wx:if="{{!busy && !snapshotId}}" class="primary" bindtap="again">开始或恢复分析</button><button class="secondary" bindtap="go" data-tab="true" data-url="/pages/home/index">稍后查看，返回镜像</button></view></view></view>
