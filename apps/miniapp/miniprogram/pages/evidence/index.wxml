<view class="screen {{theme}}"><mm-header back="{{true}}" bindback="back"/><view class="content"><mm-state busy="{{busy}}" error="{{error}}" bindretry="retry"/><view class="eyebrow">EVIDENCE / 每一句都有依据</view><view class="title">{{card?card.title:'这一次的音乐镜像'}}</view><block wx:if="{{report}}"><view class="note">{{report.version}} · {{report.created}}<view></view>{{report.longCount}} 首长期 / {{report.heartCount}} 首选定红心<view></view>{{report.heartWindow}}</view><view wx:if="{{card}}" class="card"><view class="heading">如何计算</view><view>{{card.method}}</view><view class="caption">{{card.statusText}} · 覆盖 {{card.coverageText}}</view><view wx:for="{{card.limitations}}" wx:key="*this" class="rule">{{item}}</view></view><view wx:if="{{!card}}"><view wx:for="{{report.cards}}" wx:key="id" class="card" bindtap="open" data-id="{{item.id}}"><view class="heading">{{item.title}} ›</view><view class="muted">{{item.statusText}} · {{item.summaries[0] || item.purpose}}</view></view><view wx:if="{{report.legacy}}" class="card"><view class="heading">历史旧版报告</view><view wx:for="{{legacyRows}}" wx:key="name" class="rule">{{item.name}}：{{item.value}}<view class="caption">{{item.reason}}</view></view></view></view><view class="card facts"><view class="heading">事实明细 · {{count}} 项</view><view wx:for="{{facts}}" wx:key="index" class="rule"><view class="fact-label">{{item.label}}</view><view>{{item.value}}</view></view><button wx:if="{{facts.length < count}}" class="link" bindtap="more">继续查看明细</button></view><view class="card facts"><view class="heading">来源与时间</view><view wx:for="{{provenance}}" wx:key="index" class="rule"><view class="fact-label">{{item.label}}</view><view>{{item.value}}</view></view></view><view class="actions"><button class="secondary" bindtap="share">生成分享图片</button><button class="secondary" bindtap="exportReport">导出本次报告</button></view></block></view></view>
