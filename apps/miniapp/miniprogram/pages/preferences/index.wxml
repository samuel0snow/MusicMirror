<view class="screen {{theme}}"><mm-header back="{{true}}" bindback="back"/><view class="content"><mm-state busy="{{busy}}" error="{{error}}" bindretry="retry"/><view class="eyebrow">PREFERENCE / 输入 2</view><view class="title">我的主动偏好</view><block wx:if="{{status==='available'}}"><view class="note">{{sample}} 首主动选择 · 每首歌曲等权<view></view>{{timeWindowText}} · 红心状态可核验</view><view class="grid"><view class="card"><view class="big">{{overlapText}}</view><view class="muted">与长期样本重合</view></view><view class="card"><view class="big">{{newArtistText}}</view><view class="muted">选定红心中的新艺人权重</view></view></view><view wx:if="{{dimensions.length}}" class="tabs"><button wx:for="{{dimensions}}" wx:key="id" class="{{dimension===item.id?'selected':''}}" bindtap="dimension" data-id="{{item.id}}" disabled="{{busy}}">{{item.label}}</button></view><view class="card"><mm-chart kind="{{dimensions.length?'bars':'empty'}}" rows="{{chartRows}}" caption="{{caption}}"/><view wx:if="{{dimensions.length}}" class="caption">加权覆盖 {{coverageText}} · 覆盖表示资料充分度，不是正确概率</view><view wx:else class="muted">缺少曲风、语种或年代标签，该维度不展示。</view></view><view wx:if="{{observations.length}}" class="card"><view class="heading">观察</view><view wx:for="{{observations}}" wx:key="*this" class="rule">{{item}}</view></view><view wx:if="{{warnings.length}}" class="card"><view class="heading">解释边界</view><view wx:for="{{warnings}}" wx:key="*this" class="rule muted">{{item}}</view></view><button class="secondary" bindtap="evidence" disabled="{{!snapshotId}}">查看证据与来源</button><view class="actions"><button class="secondary" bindtap="alignment" disabled="{{!snapshotId}}">与长期聆听对照</button><button class="primary" bindtap="edit">编辑选定红心</button><button class="link" bindtap="structure">查看长期结构 →</button></view></block><block wx:else><view class="card"><mm-chart kind="empty"/><view class="heading">红心模块，留给你的选择</view><view class="muted">{{status==='empty'?'你已清空选定红心':'尚未配置选定红心'}}，长期聆听仍可独立生成报告。</view><view class="caption">不以最近播放代替主动红心；保存并刷新后才影响新报告。</view><button class="primary" bindtap="edit">选择红心歌曲</button><button class="secondary" bindtap="structure">先查看长期聆听</button></view></block></view></view>
