<view class="screen {{theme}}"><mm-header back="{{true}}" bindback="back"/><view class="content"><mm-state busy="{{busy}}" error="{{error}}" bindretry="retry"/><block wx:if="{{card}}"><view class="eyebrow">AESTHETIC / 审美线索</view><view class="title">{{card.title}}</view><view class="subtitle">{{card.purpose}}</view><view class="tabs"><button class="{{variant==='base'?'selected':''}}" bindtap="variant" data-id="base">现有数据</button><button class="{{variant==='enhanced'?'selected':''}}" bindtap="variant" data-id="enhanced">增强分析</button></view><view class="badge">{{card.statusText}}</view><view class="badge cyan">加权覆盖 {{card.coverageText}}</view><view class="card"><mm-chart kind="{{card.chart.kind}}" value="{{card.chart.value}}" rows="{{card.chart.rows}}" caption="{{card.chart.caption}}"/><view wx:for="{{card.summaries}}" wx:key="*this" class="rule">{{item}}</view><view wx:if="{{card.status==='unavailable'}}" class="heading">这部分资料还不足以判断</view></view><view wx:if="{{card.requiredData.length}}" class="card"><view class="heading">需要哪些资料</view><view wx:for="{{card.requiredData}}" wx:key="*this" class="rule">{{item}}</view><view class="caption">当前不自动补齐这些来源；不会以付费解锁替代真实资料。</view></view><view wx:if="{{card.status!=='unavailable'}}" class="card facts"><view class="heading">可核对的事实</view><view wx:for="{{previewFacts}}" wx:key="index" class="rule"><view class="fact-label">{{item.label}}</view><view class="fact-value">{{item.value}}</view></view></view><view class="card"><view class="heading">解释边界</view><view wx:for="{{card.limitations}}" wx:key="*this" class="rule muted">{{item}}</view></view><button class="primary" bindtap="evidence">查看全部证据与计算说明</button><view class="caption">{{sample}}<view></view>采集于 {{created}}<view></view>覆盖率表示资料充分度，不是正确概率。</view></block></view></view>
