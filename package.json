{
  "name": "musicmirror",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/api",
    "apps/miniapp",
    "apps/web-preview",
    "packages/*"
  ],
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts",
    "dev:lan": "node --env-file-if-exists=.env --import tsx apps/api/src/server.ts --lan",
    "dev:watch": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/apps/api/src/server.js",
    "test": "node --import tsx --test tests/algorithms/*.test.ts tests/contracts/*.test.ts tests/integration/*.test.ts tests/e2e/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run smoke",
    "export:account": "npm run build && node scripts/export-account.mjs",
    "enrich:account": "npm run build && node scripts/enrich-account.mjs",
    "data:organize": "node scripts/organize-test-data.mjs",
    "explore:account": "npm run build && node scripts/explore-account.mjs",
    "verify:memory": "npm run build && node scripts/verify-song-memory-coverage.mjs",
    "analyze:aesthetic": "npm run build && node scripts/analyze-aesthetic.mjs",
    "dev:web": "npm run dev --workspace @musicmirror/web-preview",
    "build:web": "npm run build --workspace @musicmirror/web-preview",
    "test:web": "npm run test --workspace @musicmirror/web-preview"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
